#include "ghidorah.dtsi"

/* Enable and configure existing I2C controller */
&i2c0 {
    status = "okay";
    scl-pin = <6>;   /* P0.06 = D1 */
    sda-pin = <8>;   /* P0.08 = D0 */

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        prechargep = <0x22>;
        status = "okay";
    };
};

/* Tell Zephyr/ZMK this is the active display */
&{/chosen} {
    zephyr,display = &oled;
};

/* Existing matrix config, unchanged */
&kscan0 {
    col-gpios =
        <&pro_micro 10 GPIO_ACTIVE_HIGH>,
        <&pro_micro 16 GPIO_ACTIVE_HIGH>,
        <&pro_micro 14 GPIO_ACTIVE_HIGH>,
        <&pro_micro 15 GPIO_ACTIVE_HIGH>,
        <&pro_micro 18 GPIO_ACTIVE_HIGH>,
        <&pro_micro 19 GPIO_ACTIVE_HIGH>;
};
